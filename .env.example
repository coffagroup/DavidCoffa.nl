# Next.js server-side connection to the separate Coffa OS API.
# Use an absolute origin, e.g. https://your-api.onrender.com (no /api path).
COFFA_API_URL=
# Optional GA4 measurement ID. The tag is only loaded after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Must match Contact__ApiKey on the .NET service. Never expose with NEXT_PUBLIC_.
COFFA_CONTACT_KEY=

# Legacy contact storage only: leave both COFFA_* values empty to use this.
DATABASE_URL=
CONTACT_ALLOWED_ORIGIN=
