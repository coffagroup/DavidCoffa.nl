# Productie: PostgreSQL-verbindingsstring van de database voor het toekomstige dashboard.
# Deel deze niet in clientcode of in Git. Gebruik de TLS-instellingen van je databaseprovider.
DATABASE_URL=

# Optioneel: expliciete publieke origin als de reverse proxy de origin herschrijft.
# Lokaal leeg laten; standaard wordt dezelfde origin als het POST-verzoek vereist.
CONTACT_ALLOWED_ORIGIN=
